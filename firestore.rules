rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public catalog: Anyone can read active products. Only Admin can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Guest customers can create an order. Public can track single order by exact ID. Admin can verify.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderNumber is string &&
                       request.resource.data.paymentStatus == 'pending_verification' &&
                       request.resource.data.orderStatus == 'waiting_payment';
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Global Store Settings: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Reviews: Public read approved reviews. Anyone can submit pending review. Admin can approve.
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.approved == false;
      allow update, delete: if isAdmin();
    }

    // Admin whitelist
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
